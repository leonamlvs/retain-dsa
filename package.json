{
  "name": "retain-dsa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/api-client"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "build": "yarn workspace @retain/api build && yarn workspace @retain/web build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "yarn test --selectProjects unit-api unit-web",
    "test:provider": "yarn test --selectProjects provider",
    "test:integration": "yarn test --selectProjects database",
    "test:e2e": "playwright test",
    "verify": "yarn docs:check && yarn format:check && yarn lint && yarn typecheck && yarn check:client && yarn test && yarn test:e2e && yarn build",
    "generate:client": "tsx scripts/generate-client.ts",
    "generate:db": "prisma generate --config ./prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "check:client": "tsx scripts/generate-client.ts --check",
    "docs:check": "node scripts/check-docs.mjs",
    "config:activate": "tsx scripts/activate-configuration.ts",
    "dev": "docker compose up --build",
    "dev:api": "yarn workspace @retain/api dev",
    "dev:web": "yarn workspace @retain/web dev",
    "smoke:leetcode": "tsx scripts/smoke-leetcode.ts"
  },
  "resolutions": {
    "@prisma/config/deepmerge-ts": "8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "fast-check": "4.10.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "msw": "2.15.0",
    "nock": "14.0.17",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
